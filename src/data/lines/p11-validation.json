  {
    "id": "p11_relationship_shift_midlife",
    "version": "1.0.0",
    "category": "main_story",
    "priority": 1,
    "weight": 85,
    "ageRange": { "min": 24, "max": 28 },
    "triggers": [{ "type": "age_reach", "value": 24 }],
