              "delta": 20
            }
          },
          {
            "type": "event_record",
            "target": "sect_path_choice_orthodox"
          }
        ]
      },
      {
        "id": "stay_wanderer",
        "text": "行走江湖，观望时局",
        "description": "你谢绝门派邀约，独自踏入江湖，先看天下再定去留。",
        "effects": [
          {
            "type": "flag_set",
