                "target": "chivalry",
                "value": 10,
                "operator": "add"
              }
            ]
          },
          "failure": {
            "id": "jianghu_grudge_fight_failure",
            "text": "比试中你落败，依约点到为止地收手。这次胜负不能证明对方所说的旧怨属实，双方之后如何仍待商议。",
            "effects": []
          }
        }
      },
