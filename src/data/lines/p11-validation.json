      }
    ],
    "content": {
      "title": "旧友重逢",
      "text": "你在二十余岁行走江湖，一位早年结识的旧友突然寻来。对方带来一则关乎取舍的消息——这段关系将改变你此后数年的走向。",
      "description": "P11 20-30 阶段关系转折验证"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "deepen_bond",
        "text": "加深情谊，共担风险",
        "effects": [
          { "type": "stat_modify", "target": "connections", "value": 8, "operator": "add" },
          { "type": "flag_set", "target": "p11_relationship_shift_seen", "value": true }
        ]
      },
      {
        "id": "keep_distance",
        "text": "保持距离，各自前行",
        "effects": [
          { "type": "stat_modify", "target": "reputation", "value": 5, "operator": "add" },
          { "type": "flag_set", "target": "p11_relationship_shift_seen", "value": true }
        ]
      }
    ],
    "metadata": {
      "enabled": true,
      "tags": ["p11", "stage_feedback", "relationship", "social"],
      "pathAffinity": { "social": 1.0 },
      "narrativeScheduling": {
        "stageSignals": ["relationship_shift"],
        "routePoints": []
      }
    }
  },
