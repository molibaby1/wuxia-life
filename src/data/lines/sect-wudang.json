          { "type": "event_record", "target": "sect_midlife_judgment_deflect" }
        ]
      },
      {
        "id": "judgment_silence",
        "text": "沉默应对",
        "description": "你选择不置一词，保守派与革律派皆怨。【L1 两面不讨好】",
        "condition": { "type": "expression", "expression": "flags.has(\"sect_midlife_lean_neutral\") || (!flags.has(\"sect_midlife_lean_conservative\") && !flags.has(\"sect_midlife_judgment_confess\"))" },
        "effects": [
