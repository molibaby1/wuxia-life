[
  {
    "id": "mingyue_market_meet",
    "version": "1.0.0",
    "category": "side_quest",
    "priority": 1,
    "weight": 80,
    "ageRange": { "min": 15, "max": 20 },
    "triggers": [{ "type": "age_reach", "value": 15 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "!events.has(\"mingyue_market_meet\")"
      }
    ],
    "content": {
      "title": "市集上的账簿",
      "text": "市集忽然传来争执：一名摊主把一册记账簿摔在地上，指责货商少交了一批药材。明月蹲下捡起账簿，发现两边的记号都被雨水洇开了。她没有急着替谁说话，只请双方把还能核对的货箱重新点一遍。",
      "description": "一件地方小事，让你有机会看见明月如何面对责任与现实。"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "mingyue_participate",
        "text": "留下来帮忙核对货物",
        "description": "你参与处理眼前的事情，也因此真正认识了明月。",
        "effects": [
          { "type": "time_advance", "target": "age", "value": 3, "timeUnit": "month" },
          { "type": "flag_set", "target": "mingyue_met", "value": true },
          { "type": "event_record", "target": "mingyue_market_participated" }
        ]
      },
      {
        "id": "mingyue_pass_by",
        "text": "不介入，继续赶路",
        "description": "你只是从争执旁经过，明月也没有进入你这一局人生。",
        "effects": [
          { "type": "time_advance", "target": "age", "value": 1, "timeUnit": "day" },
          { "type": "event_record", "target": "mingyue_market_passed" }
        ]
      }
    ],
    "metadata": {
      "createdAt": 1780000000000,
      "updatedAt": 1780000000000,
      "author": "development_team",
      "tags": ["人物", "明月", "市集", "once"],
      "enabled": true
    },
    "storyLine": "mingyue_character",
    "cooldown": 0
  },
  {
    "id": "mingyue_second_encounter",
    "version": "1.0.0",
    "category": "side_quest",
    "priority": 1,
    "weight": 70,
    "ageRange": { "min": 16, "max": 24 },
    "triggers": [{ "type": "age_reach", "value": 16 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "flags.has(\"mingyue_met\") && !events.has(\"mingyue_second_encounter\")"
      }
    ],
    "content": {
      "title": "旧账的新去处",
      "text": "几个月后，你在渡口再次见到明月。她已经把那册被雨水洇过的账簿抄成了两份：一份交给摊主，一份留给货商。她说，事情解决了，账却不能只靠某个人记得。",
      "description": "明月记得那次市集上的小事，也在用自己的方式承担后果。"
    },
    "eventType": "auto",
    "autoEffects": [
      { "type": "time_advance", "target": "age", "value": 3, "timeUnit": "month" },
      { "type": "event_record", "target": "mingyue_second_encounter" }
    ],
    "metadata": {
      "createdAt": 1780000000000,
      "updatedAt": 1780000000000,
      "author": "development_team",
      "tags": ["人物", "明月", "连续性", "once"],
      "enabled": true
    },
    "storyLine": "mingyue_character",
    "cooldown": 0
  },
  {
    "id": "mingyue_shared_experience",
    "version": "1.0.0",
    "category": "side_quest",
    "priority": 1,
    "weight": 65,
    "ageRange": { "min": 17, "max": 28 },
    "triggers": [{ "type": "age_reach", "value": 17 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "events.has(\"mingyue_second_encounter\") && !events.has(\"mingyue_shared_experience\")"
      }
    ],
    "content": {
      "title": "渡口的药箱",
      "text": "渡口一艘货船翻了半边，几箱药材泡在浅水里。明月先记下哪些药还能用，再请船主把剩下的药送到附近的医馆。她说，救急不能等账目完全清楚，但事后仍要把损失分清。",
      "description": "你们共同处理一件具体事务，明月的取舍也留下了可追溯的历史。"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "mingyue_shared_help",
        "text": "先帮她把药箱搬到医馆",
        "description": "先处理眼前的急事，再一起核对损失。",
        "effects": [
          { "type": "time_advance", "target": "age", "value": 3, "timeUnit": "month" },
          { "type": "event_record", "target": "mingyue_shared_help" }
        ]
      },
      {
        "id": "mingyue_shared_boundary",
        "text": "留下来替她守住分账的边界",
        "description": "你不替任何一方承担全部损失，但愿意确保分账不被含糊带过。",
        "effects": [
          { "type": "time_advance", "target": "age", "value": 3, "timeUnit": "month" },
          { "type": "event_record", "target": "mingyue_shared_boundary" }
        ]
      }
    ],
    "metadata": {
      "createdAt": 1780000000000,
      "updatedAt": 1780000000000,
      "author": "development_team",
      "tags": ["人物", "明月", "共同经历", "once"],
      "enabled": true
    },
    "storyLine": "mingyue_character",
    "cooldown": 0
  },
  {
    "id": "mingyue_value_conflict",
    "version": "1.0.0",
    "category": "side_quest",
    "priority": 1,
    "weight": 60,
    "ageRange": { "min": 18, "max": 32 },
    "triggers": [{ "type": "age_reach", "value": 18 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "events.has(\"mingyue_shared_experience\") && !events.has(\"mingyue_value_conflict\")"
      }
    ],
    "content": {
      "title": "家门内外",
      "text": "明月的家族要她接手一份旧账：若她替家里把几笔亏空记成尚未结清，家族能暂时保住名声，但渡口上几户小商贩会因此被追债。她不愿用别人的日子填补家里的体面，却也知道拒绝会让家人失去生计。",
      "description": "这首先是明月自己的人生选择：个人判断与家族、现实责任发生冲突。"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "mingyue_conflict_support",
        "text": "支持她承担家族后果",
        "description": "你认可她不把损失转嫁给无关的人。",
        "effects": [
          { "type": "time_advance", "target": "age", "value": 3, "timeUnit": "month" },
          { "type": "event_record", "target": "mingyue_conflict_support" }
        ]
      },
      {
        "id": "mingyue_conflict_question",
        "text": "提醒她也要顾及家人的生计",
        "description": "你不同意她只承担道德上的一边，要求她正视家族的现实处境。",
        "effects": [
          { "type": "time_advance", "target": "age", "value": 3, "timeUnit": "month" },
          { "type": "event_record", "target": "mingyue_conflict_question" }
        ]
      },
      {
        "id": "mingyue_conflict_boundary",
        "text": "说明你不会替她作决定",
        "description": "你承认这是她必须承担的选择，但愿意在她决定后面对结果。",
        "effects": [
          { "type": "time_advance", "target": "age", "value": 3, "timeUnit": "month" },
          { "type": "event_record", "target": "mingyue_conflict_boundary" }
        ]
      }
    ],
    "metadata": {
      "createdAt": 1780000000000,
      "updatedAt": 1780000000000,
      "author": "development_team",
      "tags": ["人物", "明月", "家族", "现实约束", "价值冲突", "once"],
      "enabled": true
    },
    "storyLine": "mingyue_character",
    "cooldown": 0
  },
  {
    "id": "mingyue_relationship_choice",
    "version": "1.0.0",
    "category": "side_quest",
    "priority": 1,
    "weight": 55,
    "ageRange": { "min": 19, "max": 40 },
    "triggers": [{ "type": "age_reach", "value": 19 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "events.has(\"mingyue_shared_experience\") && events.has(\"mingyue_value_conflict\") && !events.has(\"mingyue_relationship_choice\")"
      }
    ],
    "content": {
      "title": "各自的决定",
      "text": "经历过渡口的药箱与家门内外的争执后，明月把话说得很清楚：她愿意继续把你当作重要的人，但不愿让任何关系替她承担本该由她面对的家族选择。你们需要决定这段关系以什么方式继续。",
      "description": "关系性质由共同前史与当下选择共同形成，不是一次相遇的自动结论。"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "mingyue_choose_romantic",
        "text": "明确进一步发展感情",
        "description": "你们都确认愿意以恋爱关系继续相处，同时保留各自面对现实的边界。",
        "effects": [
          { "type": "flag_set", "target": "mingyue_romance_confirmed", "value": true },
          { "type": "flag_unset", "target": "mingyue_non_romantic_relationship" },
          { "type": "event_record", "target": "mingyue_relationship_romantic" }
        ]
      },
      {
        "id": "mingyue_choose_non_romantic",
        "text": "不发展为恋爱，但继续相互扶持",
        "description": "你们确认这段关系的重要性，却不把它定义为恋爱。",
        "effects": [
          { "type": "flag_set", "target": "mingyue_non_romantic_relationship", "value": true },
          { "type": "flag_unset", "target": "mingyue_romance_confirmed" },
          { "type": "event_record", "target": "mingyue_relationship_non_romantic" }
        ]
      }
    ],
    "metadata": {
      "createdAt": 1780000000000,
      "updatedAt": 1780000000000,
      "author": "development_team",
      "tags": ["人物", "明月", "关系选择", "once"],
      "enabled": true
    },
    "storyLine": "mingyue_character",
    "cooldown": 0
  },
  {
    "id": "mingyue_echo_romantic",
    "version": "1.0.0",
    "category": "side_quest",
    "priority": 1,
    "weight": 45,
    "ageRange": { "min": 30, "max": 60 },
    "triggers": [{ "type": "age_reach", "value": 30 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "flags.has(\"mingyue_romance_confirmed\") && events.has(\"mingyue_relationship_choice\") && !events.has(\"mingyue_echo_romantic\")"
      }
    ],
    "content": {
      "title": "仍在商量的人生",
      "text": "多年后，明月带着一份新的家族账目来找你。你们仍会争论怎样面对家人的期待，也仍会在争论后把各自愿意承担的部分写清楚。这段感情没有替你们消除现实，只让你们继续共同面对它。",
      "description": "较晚的人生事件读取你们明确建立感情的事实。"
    },
    "eventType": "auto",
    "autoEffects": [
      { "type": "event_record", "target": "mingyue_echo_romantic" }
    ],
    "metadata": {
      "createdAt": 1780000000000,
      "updatedAt": 1780000000000,
      "author": "development_team",
      "tags": ["人物", "明月", "后续回响", "once"],
      "enabled": true
    },
    "storyLine": "mingyue_character",
    "cooldown": 0
  },
  {
    "id": "mingyue_echo_non_romantic",
    "version": "1.0.0",
    "category": "side_quest",
    "priority": 1,
    "weight": 45,
    "ageRange": { "min": 30, "max": 60 },
    "triggers": [{ "type": "age_reach", "value": 30 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "flags.has(\"mingyue_non_romantic_relationship\") && events.has(\"mingyue_relationship_choice\") && !events.has(\"mingyue_echo_non_romantic\")"
      }
    ],
    "content": {
      "title": "旧识的新信",
      "text": "多年后，明月托人送来一封信：她接手的渡口终于换了新的账法，想请你为一批远行的人引路。你们没有成为恋人，却仍会在各自的人生需要时记得那段共同处理过的旧事。",
      "description": "不发展为恋爱并没有抹去明月；共同经历仍然在后来的人生中产生回响。"
    },
    "eventType": "auto",
    "autoEffects": [
      { "type": "event_record", "target": "mingyue_echo_non_romantic" }
    ],
    "metadata": {
