    "version": "1.0.0",
    "category": "main_story",
    "priority": 0,
    "weight": 195,
    "ageRange": { "min": 36, "max": 45 },
    "triggers": [{ "type": "age_reach", "value": 36 }],
    "conditions": [
      {
        "type": "expression",
