        "type": "expression",
        "expression": "chivalry >= 40 && martialPower >= 50"
      }
    ],
    "content": {
      "title": "救命之恩",
      "text": "你在路旁遇见一名危急之人，是否冒险出手相救？这将决定是否留下由对方日后回应的救命之恩。",
      "description": "救命之恩"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "relationship_life_saving_save",
        "text": "出手相救，留下这段恩情",
        "effects": [
          {
            "type": "flag_set",
            "target": "life_debt_owed_to_player",
            "value": true
          }
        ]
      },
      {
        "id": "relationship_life_saving_not_save",
        "text": "不涉险相救，继续赶路",
        "effects": []
      }
    ]
  },
