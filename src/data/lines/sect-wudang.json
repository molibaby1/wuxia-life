          },
          { "type": "stat_modify", "target": "chivalry", "value": 4, "operator": "add" },
          { "type": "event_record", "target": "sect_midlife_gray_refuse" }
        ]
      },
      {
        "id": "gray_refuse_order_lenient",
        "text": "拒令请罪（师门念旧）",
        "description": "你拒令请罪。清虚真人叹道：「当年行善过甚，今日不忍再杀。」仅罚你禁闭思过。【L1 减罚】",
        "condition": { "type": "expression", "expression": "flags.has(\"orthodox_trial_exceeded\") || events.has(\"orthodox_trial_service_aid_great\")" },
        "effects": [
          { "type": "flag_set", "target": "sect_midlife_gray_refused" },
          {
            "type": "relation_change",
            "target": "master",
            "operator": "add",
            "value": { "id": "master_qingxu", "name": "清虚真人", "role": "master", "delta": -3 }
          },
          { "type": "stat_modify", "target": "chivalry", "value": 5, "operator": "add" },
          { "type": "event_record", "target": "sect_midlife_gray_refuse_lenient" }
        ]
      }
