      "description": "为大局妥协，或守侠义底线"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "gray_execute_order",
        "text": "奉命行事",
        "description": "你按令行事，门派嘉奖，侠义之名却蒙尘。【L2 道德代价】",
        "condition": { "type": "expression", "expression": "!events.has(\"orthodox_trial_service_meditate\")" },
        "effects": [
          { "type": "flag_set", "target": "sect_midlife_gray_executed" },
          { "type": "stat_modify", "target": "reputation", "value": 6, "operator": "add" },
          { "type": "stat_modify", "target": "chivalry", "value": -8, "operator": "add" },
          { "type": "event_record", "target": "sect_midlife_gray_execute" }
        ]
      },
      {
        "id": "gray_execute_order_meditate",
        "text": "奉命行事（心中犹疑）",
        "description": "你当年以智谋退敌，如今却要亲手了结曾救之人。师门嘉奖，你却夜不能寐。【L2 道德代价】",
        "condition": { "type": "expression", "expression": "events.has(\"orthodox_trial_service_meditate\") || events.has(\"orthodox_trial_service_meditate_partial\")" },
        "effects": [
          { "type": "flag_set", "target": "sect_midlife_gray_executed" },
          { "type": "stat_modify", "target": "reputation", "value": 5, "operator": "add" },
          { "type": "stat_modify", "target": "chivalry", "value": -10, "operator": "add" },
          { "type": "event_record", "target": "sect_midlife_gray_execute_meditate" }
        ]
      },
      {
        "id": "gray_leak_warning",
        "text": "暗中放走并瞒报",
        "description": "你悄悄示警，瞒过上级。侠义尚在，但若东窗事发则名节尽毁。【L2 东窗事发】",
        "effects": [
          { "type": "flag_set", "target": "sect_midlife_gray_leaked" },
          { "type": "stat_modify", "target": "chivalry", "value": 6, "operator": "add" },
          { "type": "stat_modify", "target": "reputation", "value": -5, "operator": "add" },
          { "type": "event_record", "target": "sect_midlife_gray_leak" }
        ]
      },
      {
        "id": "gray_refuse_order",
        "text": "拒令请罪",
        "description": "你当殿拒令，愿受门规惩处。清虚真人震怒，却念你昔日功绩从轻发落。【L1 可避重罚】",
        "effects": [
          { "type": "flag_set", "target": "sect_midlife_gray_refused" },
          {
            "type": "relation_change",
