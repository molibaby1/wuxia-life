  {
    "id": "mingyue_echo_conflict_support",
    "version": "1.0.0",
    "category": "side_quest",
    "priority": 1,
    "weight": 40,
    "ageRange": { "min": 30, "max": 60 },
    "triggers": [{ "type": "age_reach", "value": 30 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "events.has(\"mingyue_relationship_choice\") && events.has(\"mingyue_conflict_support\") && !events.has(\"mingyue_echo_conflict_support\")"
      }
    ],
    "content": {
      "title": "明月记得你的立场",
      "text": "多年后，明月再次提起家门内外的那场争执。她记得你当时支持她承担家族选择的后果，也记得那份支持没有替她作决定。如今她仍按自己的判断处理新的账目，只把你当年如何看待这件事当作一段清楚的共同历史。",
      "description": "后续回响读取具体的价值冲突前史，只改变人物反应，不决定关系性质。"
    },
    "eventType": "auto",
    "autoEffects": [
      { "type": "event_record", "target": "mingyue_echo_conflict_support" }
    ],
