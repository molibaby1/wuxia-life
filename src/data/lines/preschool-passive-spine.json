{
  "entries": [
    {
      "id": "preschool_scholar_clever_speech",
      "title": "伶牙俐齿",
      "text": "你在长辈面前背出半阙蒙学诗，虽吐字不清，却把「天地玄黄」说得有板有眼，满座皆笑。",
      "originTags": ["scholar"],
      "ageMin": 3,
      "ageMax": 3,
      "statDeltas": { "comprehension": 1 }
    },
    {
      "id": "preschool_scholar_library_dust",
      "title": "书斋尘香",
      "text": "你踮脚够不到书架，便坐在梯下翻画谱，墨香与旧纸味混在一起，成了这一季最深的记忆。",
      "originTags": ["scholar"],
      "ageMin": 5,
      "ageMax": 7,
      "statDeltas": { "comprehension": 1 }
    },
    {
      "id": "preschool_scholar_gate_visitor",
      "title": "门庭来客",
      "text": "有远客来谈诗论道，你在帘后偷听半晌，记住了几个陌生的地名与典故。",
      "originTags": ["scholar"],
      "ageMin": 6,
      "ageMax": 7
    },
    {
      "id": "preschool_martial_first_stance",
      "title": "初识马步",
      "text": "父亲教你扎马步，你坚持不到半盏茶便腿软，却被夸「肯下苦功」。",
      "originTags": ["martial"],
      "ageMin": 3,
      "ageMax": 4,
      "statDeltas": { "constitution": 1 }
    },
    {
      "id": "preschool_martial_weapon_rack",
      "title": "兵器架下",
      "text": "你趁练武场无人，摸过几柄未开刃的短刀，被师兄发现后笑骂一句，却也没真罚。",
      "originTags": ["martial"],
      "ageMin": 5,
      "ageMax": 7,
      "statDeltas": { "constitution": 1 }
    },
    {
      "id": "preschool_martial_evening_drill",
      "title": "暮鼓操练",
      "text": "暮色里传来整齐号子，你学着举棍刺向木桩，虽力道不足，气势倒像模像样。",
      "originTags": ["martial"],
      "ageMin": 6,
      "ageMax": 7
    },
    {
      "id": "preschool_merchant_first_coin",
      "title": "第一枚铜钱",
      "text": "长辈让你把一枚铜钱从左手交到右手，再交给伙计，你认真数了三遍才肯松手。",
      "originTags": ["merchant"],
      "ageMin": 3,
      "ageMax": 4
    },
    {
      "id": "preschool_merchant_ledger_peek",
      "title": "偷看账本",
      "text": "你趴在柜后看父亲拨算盘，虽看不懂进销，却记住了「利薄」「赊欠」几个词。",
      "originTags": ["merchant"],
      "ageMin": 5,
      "ageMax": 7,
      "statDeltas": { "businessAcumen": 1 }
    },
    {
      "id": "preschool_merchant_caravan_news",
      "title": "商队见闻",
      "text": "过路商队歇脚，你听人讲外地物价与路况，回来竟能学舌给邻居听。",
      "originTags": ["merchant"],
      "ageMin": 6,
      "ageMax": 7
    },
    {
      "id": "preschool_frontier_bonfire_tale",
      "title": "营火夜话",
      "text": "夜里营火边有人讲边关旧事，你裹紧小袄听得入神，风沙声里夹着远处马嘶。",
      "originTags": ["frontier"],
      "ageMin": 3,
      "ageMax": 4
    },
    {
      "id": "preschool_frontier_sentry_watch",
      "title": "望哨初体验",
      "text": "你跟着亲兵登上短墙，看烽火台在夕照里变暗，第一次觉得「家」也有边界。",
      "originTags": ["frontier"],
      "ageMin": 5,
      "ageMax": 7,
      "statDeltas": { "constitution": 1 }
    },
    {
      "id": "preschool_frontier_horse_whinny",
      "title": "战马嘶鸣",
      "text": "马厩里战马齐嘶，你既怕又兴奋，父亲说你若再长高些，便教你识蹄印。",
      "originTags": ["frontier"],
      "ageMin": 6,
      "ageMax": 7
    },
    {
      "id": "preschool_scholar_mengxue_echo",
      "title": "蒙学跟读",
      "text": "你跟着兄长念千字文，错字被温言纠正，虽不懂涵义，却记住了朗朗节奏。",
      "originTags": ["scholar"],
      "ageMin": 4,
      "ageMax": 5,
      "statDeltas": { "comprehension": 1 }
    },
    {
      "id": "preschool_scholar_rain_eaves",
      "title": "雨巷听书",
      "text": "雨天廊下，先生讲半段史记，你记住了「背水」二字，却不知背后战事。",
      "originTags": ["scholar"],
      "ageMin": 5,
      "ageMax": 6
    },
    {
      "id": "preschool_martial_wood_dummy",
      "title": "木人试拳",
      "text": "你对练功木人乱拳，拳风虽弱却有架势，师兄笑你「花拳绣腿」，你却练得更起劲。",
      "originTags": ["martial"],
      "ageMin": 5,
      "ageMax": 6,
      "statDeltas": { "constitution": 1 }
    },
    {
      "id": "preschool_martial_mist_run",
      "title": "晨雾跑桩",
      "text": "晨雾里跟师兄绕桩，喘得厉害却不肯停，雾散时衣襟已湿透。",
      "originTags": ["martial"],
      "ageMin": 4,
      "ageMax": 5
    },
    {
      "id": "preschool_merchant_counter_count",
      "title": "柜台数货",
      "text": "你帮伙计数布匹，数到十便得意地大声念出，客人夸你「伶俐」，父亲却让你再数一遍。",
      "originTags": ["merchant"],
      "ageMin": 5,
      "ageMax": 6
    },
    {
      "id": "preschool_merchant_haggle_listen",
      "title": "议价旁听",
      "text": "帘后听父亲与客人还价，你学舌「再添一文」，被轻拍脑袋，却记住了语气里的分寸。",
      "originTags": ["merchant"],
      "ageMin": 4,
      "ageMax": 5
    },
    {
      "id": "preschool_frontier_sand_veil",
      "title": "风沙掩目",
      "text": "风起沙扬，你第一次被教用袖遮面，沙粒打在颊上刺痛，却觉得边关风也有味道。",
      "originTags": ["frontier"],
      "ageMin": 5,
      "ageMax": 6,
      "statDeltas": { "constitution": 1 }
    },
    {
      "id": "preschool_frontier_tent_smoke",
      "title": "毡帐炊烟",
      "text": "跟母亲看帐外炊烟辨风向，她说烟往东南，今日不会有大军过境。",
      "originTags": ["frontier"],
      "ageMin": 4,
      "ageMax": 5
    },
    {
      "id": "preschool_scholar_ink_stone",
      "title": "砚边习字",
      "text": "你在砚边描红，墨痕歪扭，却被夸「笔画有劲」，心里第一次觉得写字有趣。",
      "originTags": ["scholar"],
      "ageMin": 3,
      "ageMax": 7,
      "statDeltas": { "comprehension": 1 }
    },
    {
      "id": "preschool_scholar_seal_imprint",
      "title": "朱印初识",
      "text": "父亲让你按朱印在信笺角上，印泥凉润，你记住了「名姓」二字的写法。",
      "originTags": ["scholar"],
      "ageMin": 6,
      "ageMax": 7
    },
    {
      "id": "preschool_martial_yard_dust",
      "title": "练武场尘",
      "text": "练武场尘土飞扬，你追着师兄脚步跑圈，摔了也不哭，爬起来继续。",
      "originTags": ["martial"],
      "ageMin": 3,
      "ageMax": 7,
      "statDeltas": { "constitution": 1 }
    },
    {
      "id": "preschool_martial_blade_kata",
      "title": "学棍比试",
      "text": "你和堂弟用木棍比划，虽被一招扫倒，却记住了「护头」的要诀。",
      "originTags": ["martial"],
      "ageMin": 3,
      "ageMax": 4
    },
    {
      "id": "preschool_merchant_abacus_rhythm",
      "title": "算盘节律",
      "text": "算盘声噼啪作响，你跟着节奏默念数字，虽常错行，却觉得像唱歌。",
      "originTags": ["merchant"],
      "ageMin": 3,
      "ageMax": 7
    },
    {
      "id": "preschool_merchant_stall_voice",
      "title": "叫卖跟学",
      "text": "你学伙计吆喝「新鲜瓜果」，嗓子稚嫩，却引来路人驻足一笑。",
      "originTags": ["merchant"],
      "ageMin": 3,
      "ageMax": 4
    },
    {
      "id": "preschool_frontier_wind_listen",
      "title": "听风辨向",
      "text": "亲兵教你侧耳听风，说北风紧时要关紧帐门，你把这话记了一整天。",
      "originTags": ["frontier"],
      "ageMin": 3,
      "ageMax": 7,
      "statDeltas": { "constitution": 1 }
    },
    {
      "id": "preschool_frontier_night_patrol",
      "title": "夜哨火光",
      "text": "夜里远处火光一闪，父亲说是巡哨举火，你第一次觉得黑夜并不空荡。",
      "originTags": ["frontier"],
      "ageMin": 6,
      "ageMax": 7
    },
    {
      "id": "preschool_peasant_harvest_help",
      "title": "帮收谷穗",
      "text": "你踮脚把散落的谷穗拢进篮里，手指被芒刺扎红，却听母亲夸「肯帮忙。」",
      "originTags": ["peasant"],
      "ageMin": 4,
      "ageMax": 5,
      "flags": ["preschool_peasant_harvest_help"],
      "statDeltas": { "constitution": 1 }
    },
    {
      "id": "preschool_peasant_well_watch",
      "title": "井台看天",
      "text": "你在村井边看大人打水，听他们聊年景与税赋，记住了「旱」和「歉收」两个词。",
      "originTags": ["peasant"],
      "ageMin": 6,
      "ageMax": 7,
      "flags": ["preschool_peasant_well_watch"]
    },
    {
      "id": "preschool_apprentice_plane_shavings",
      "title": "刨花满袖",
      "text": "师傅让你递刨子，你递错了面，被轻敲手背——「认工具，先认规矩。」",
      "originTags": ["apprentice"],
      "ageMin": 4,
      "ageMax": 5,
      "flags": ["preschool_apprentice_plane_shavings"],
      "statDeltas": { "comprehension": 1 }
    },
    {
      "id": "preschool_apprentice_market_errand",
      "title": "赶集差事",
      "text": "父亲让你去集市买漆，你记错色号被说了一通，却也因此记住了「样品要对。」",
      "originTags": ["apprentice"],
      "ageMin": 6,
      "ageMax": 7,
      "flags": ["preschool_apprentice_market_errand"]
    },
    {
      "id": "preschool_tavern_tray_balance",
      "title": "端盘练稳",
      "text": "母亲让你端空盘练手，走三步停一步，洒了便重来——「跑堂第一功是稳。」",
      "originTags": ["tavern"],
      "ageMin": 4,
      "ageMax": 5,
      "flags": ["preschool_tavern_tray_balance"]
    },
    {
      "id": "preschool_tavern_rumor_listen",
      "title": "帘后听风",
      "text": "你在后堂帘后听客人聊江湖轶事，记住了几个门派名字，却不敢插嘴。",
      "originTags": ["tavern"],
      "ageMin": 6,
      "ageMax": 7,
      "flags": ["preschool_tavern_rumor_listen"]
    }
  ]
}
