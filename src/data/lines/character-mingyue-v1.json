          { "type": "event_record", "target": "mingyue_child_arrival_direct_care" }
        ]
      },
      {
        "id": "mingyue_child_arrival_external_duties",
        "text": "接过更多家庭对外事务，让明月先恢复",
        "description": "孩子出生后的最初几个月，你先承担更多对外事务，让明月有时间恢复，再共同调整日常。",
        "effects": [
          { "type": "stat_modify", "target": "children", "value": 1, "operator": "add" },
          { "type": "flag_set", "target": "has_child", "value": true },
          { "type": "time_advance", "target": "age", "value": 6, "timeUnit": "month" },
          { "type": "event_record", "target": "mingyue_child_arrival_external_duties" }
        ]
      }
    ],
