  {
    "id": "orthodox_departure",
    "version": "1.0.0",
    "category": "special_event",
    "priority": 2,
    "weight": 15,
    "ageRange": { "min": 18, "max": 40 },
    "triggers": [{ "type": "age_reach", "value": 18 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "flags.has(\"route_orthodox\") && !flags.has(\"orthodox_departed\")"
      }
    ],
    "content": {
      "text": "你向师门请辞，下山远行。若想改换道路，需先离开门墙。",
      "title": "辞别师门",
      "description": "一别山门，再入江湖。"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "orthodox_leave",
        "text": "下山离派",
