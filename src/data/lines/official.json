    "priority": 1,
    "weight": 40,
    "ageRange": { "min": 22, "max": 28 },
    "triggers": [{ "type": "age_reach", "value": 22 }],
    "thresholds": {
      "background": {
        "required": ["origin_scholar_family"],
        "forbidden": ["origin_wuxia_family", "origin_merchant_family"],
        "evaluation": "at_least_one"
      },
      "attributes": {
        "knowledge": { "min": 12 },
        "charisma": { "min": 8 }
      }
    },
    "conditions": [
      { "type": "expression", "expression": "!flags.has(\"route_official\") && player.knowledge >= 12 && !flags.has(\"route_beggars\") && !flags.has(\"route_border\") && !flags.has(\"route_buddhist\") && !flags.has(\"route_demonic\") && !flags.has(\"route_orthodox\") && !flags.has(\"sect_shaolin\") && !flags.has(\"sect_wudang\") && !flags.has(\"sect_emei\")" }
    ],
    "content": {
      "text": "家族希望你参加科举，走仕途之路。",
      "title": "入仕机会",
      "description": "仕途之门初开。"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "official_accept",
        "text": "应试入仕",
        "effects": [
          { "type": "flag_set", "target": "route_official" },
          { "type": "time_advance", "target": "age", "value": 6, "timeUnit": "month" },
          { "type": "stat_modify", "target": "knowledge", "value": 3, "operator": "add" },
          { "type": "event_record", "target": "official_entry_accept" }
        ]
      },
      {
        "id": "official_decline",
        "text": "婉拒仕途",
        "effects": [
          { "type": "time_advance", "target": "age", "value": 1, "timeUnit": "month" },
          { "type": "event_record", "target": "official_entry_decline" }
        ]
      }
    ],
    "metadata": {
      "createdAt": 1773317774544,
