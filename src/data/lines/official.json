    }
  },
  {
    "id": "official_first_post",
    "version": "1.0.0",
    "category": "main_story",
    "priority": 1,
    "weight": 35,
    "ageRange": { "min": 23, "max": 32 },
    "triggers": [{ "type": "age_reach", "value": 23 }],
    "conditions": [
      { "type": "expression", "expression": "flags.has(\"route_official\") && !flags.has(\"official_first_post\")" }
    ],
    "content": {
      "text": "你初到地方任职，许慎言是与你同署的仕途同僚。衙门里一笔拖了许久的赈济账目无人愿意署名，你们只得共同核对卷宗；他逐项按程序核对来由，也把刻意留下的空白单独记下，不拿“上面自有安排”搪塞，只问这件已经接下的事，谁愿意把责任承担到最后。你第一次感到，官场的复杂不只在于事情能否办成，还在于谁肯对已经接下的责任负责。",
      "title": "初任官职",
      "description": "仕途艰险初现。"
    },
    "eventType": "auto",
    "autoEffects": [
      { "type": "time_advance", "target": "age", "value": 1, "timeUnit": "year" },
      { "type": "stat_modify", "target": "reputation", "value": 5, "operator": "add" },
      { "type": "flag_set", "target": "official_first_post" },
      { "type": "event_record", "target": "official_first_post" }
    ],
    "metadata": {
      "createdAt": 1773317774544,
      "updatedAt": 1773317774544,
      "author": "development_team",
      "tags": ["官场", "主线", "once"],
      "routeTargets": ["official"],
      "enabled": true
    }
  },
  {
    "id": "official_resign",
    "version": "1.0.0",
    "category": "special_event",
    "priority": 2,
    "weight": 12,
    "ageRange": { "min": 25, "max": 45 },
    "triggers": [{ "type": "age_reach", "value": 25 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "flags.has(\"route_official\") && events.has(\"official_first_post\") && !flags.has(\"official_resigned\")"
      }
    ],
    "content": {
      "text": "后来，你再次与许慎言共事。你们谈起此前共同接手过的事务，眼前仍有卷宗需要交清；他说自己既然签下了，就会把责任担到底。至于你是否继续仕途，由你自己决定。官场羁绊甚多，若要走回江湖路，需先辞官。",
      "title": "辞官抉择",
      "description": "庙堂与江湖，只能择一。"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "official_leave",
        "text": "辞官归隐",
        "effects": [
          { "type": "time_advance", "target": "age", "value": 1, "timeUnit": "month" },
          { "type": "flag_unset", "target": "route_official" },
          { "type": "flag_set", "target": "official_resigned" },
          { "type": "event_record", "target": "official_resign_leave" }
        ]
      },
      {
        "id": "official_stay",
        "text": "继续仕途",
        "effects": [
          { "type": "time_advance", "target": "age", "value": 15, "timeUnit": "day" },
          { "type": "flag_set", "target": "route_official_completed" },
          { "type": "event_record", "target": "official_resign_stay" }
        ]
      }
    ],
    "metadata": {
      "createdAt": 1773317774544,
      "updatedAt": 1773317774544,
      "author": "development_team",
      "tags": ["官场", "退路", "once"],
      "routeTargets": ["official"],
      "enabled": true
    }
  }
