  {
    "id": "mingyue_marriage_decision",
    "version": "1.0.0",
    "category": "side_quest",
    "priority": 1,
    "weight": 40,
    "ageRange": { "min": 30, "max": 60 },
    "triggers": [{ "type": "age_reach", "value": 30 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "flags.has(\"mingyue_romance_confirmed\") && events.has(\"mingyue_echo_romantic\") && !events.has(\"mingyue_marriage_decision\") && !flags.has(\"married\") && !player.spouse"
      }
    ],
    "content": {
      "title": "相伴之后",
      "text": "多年相伴之后，明月把婚姻看作需要共同承担的事实，而不是感情的终点。她问你是否愿意与她成婚；决定权在你。",
      "description": "婚姻是独立选择，不自动等同于恋爱完成、关系质量或家庭安排。"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "mingyue_choose_marriage",
        "text": "与明月成婚",
        "description": "将多年相伴正式写入婚姻。",
        "effects": [
          { "type": "special", "target": "set_spouse", "value": "明月" },
          { "type": "flag_set", "target": "married", "value": true }
        ]
      },
      {
        "id": "mingyue_decline_marriage",
        "text": "继续相伴，但暂不成婚",
        "description": "保留这段感情，不让系统替你定义婚姻。",
        "effects": [
          { "type": "event_record", "target": "mingyue_marriage_decision" }
        ]
      }
    ],
    "metadata": {
      "createdAt": 1780000000000,
      "updatedAt": 1780000000000,
      "author": "development_team",
      "tags": ["人物", "明月", "婚姻", "once"],
      "enabled": true
    },
    "storyLine": "mingyue_character",
    "cooldown": 0
  },
  {
    "id": "mingyue_parenthood_decision",
    "version": "1.0.0",
    "category": "side_quest",
    "priority": 1,
    "weight": 50,
    "ageRange": { "min": 30, "max": 40 },
    "triggers": [{ "type": "age_reach", "value": 30 }],
    "conditions": [
      {
        "type": "expression",
        "expression": "player.gender == \"male\" && player.spouse == \"明月\" && flags.has(\"married\") && player.children == 0 && !flags.has(\"has_child\") && !events.has(\"mingyue_parenthood_decision\") && player.age >= 30 && player.age <= 40"
      }
    ],
    "content": {
      "title": "要不要把孩子带进这段日子",
      "text": "明月把一张新的日程摊在桌上：你们已经成婚，但各自的事务仍有许多未完。她问你们是否愿意在往后的日子里迎接一个孩子，并一起承担这会改变的生活安排。",
      "description": "这是你与明月共同面对的一次具体 Parenthood 决定，不由婚姻本身自动触发。"
    },
    "eventType": "choice",
    "choices": [
      {
        "id": "mingyue_parenthood_enter",
        "text": "愿意为孩子腾出人生位置",
        "description": "你们决定进入这段新的家庭生活，但孩子不会在这一刻直接出现。",
        "effects": [
          { "type": "time_advance", "target": "age", "value": 10, "timeUnit": "month" },
          { "type": "event_record", "target": "mingyue_parenthood_chosen" }
        ]
      },
      {
        "id": "mingyue_parenthood_defer",
        "text": "现在暂不进入 Parenthood",
        "description": "你们保留这次决定的余地，婚姻与各自的生活继续照常展开。",
        "effects": [
          { "type": "event_record", "target": "mingyue_parenthood_decision" }
        ]
      }
    ],
    "metadata": {
